// Scheduled query alert: a disk/mount has less than 15% free space.
// Covers Windows (LogicalDisk) and Linux (Logical Disk) Perf records.
Perf
| where TimeGenerated > ago(10m)
| where ObjectName == "LogicalDisk" or ObjectName == "Logical Disk"
| where CounterName == "% Free Space"
| where InstanceName != "_Total"
| summarize arg_max(TimeGenerated, CounterValue) by Computer, InstanceName, ObjectName, _ResourceId
| where CounterValue < 15
| extend OS = iff(ObjectName == "LogicalDisk", "Windows", "Linux")
| project TimeGenerated, Computer, OS, DriveOrMount = InstanceName,
          FreePercent = round(CounterValue, 1), _ResourceId
